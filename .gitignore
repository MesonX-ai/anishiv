# macOS
.DS_Store

# Exceeds GitHub's 100MB file size limit - skip all .mp4 files
*.mp4

# FTP credentials (contains password)
.ftp-config.json
# Checksum manifest cache
.deploy-manifest.sha256

# Auto-generated runtime persistence file for the In-Memory Progress Monitor
# backend (progress_api.php). Generated on the server on first write via
# APCu + JSON disk fallback; never commit local/runtime copies so they cannot
# overwrite live server data during deployment.
progress_monitor.json
projects_backup.json
