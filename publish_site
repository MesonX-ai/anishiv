#!/bin/bash
# =============================================
# publish_site - Publish AniShiv.com to GitHub & GoDaddy
#
# Usage: ./publish_site [options]
#
# Options:
#   --help           Show this help message
#   --dry-run        Prepare deployment but skip git push and FTP upload
#   --skip-git       Skip git add/commit/push
#   --skip-upload    Skip FTP upload to GoDaddy
#   --message "TEXT" Custom commit message
# =============================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR"
FTP_CONFIG="$PROJECT_DIR/.ftp-config.json"
REMOTE_PATH="/public_html/anishiv"
COMMIT_MESSAGE="Publish site updates"
DRY_RUN=false
SKIP_GIT=false
SKIP_UPLOAD=false

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

print_info()    { echo -e "${YELLOW}ℹ $1${NC}"; }
print_success() { echo -e "${GREEN}✓ $1${NC}"; }
print_error()   { echo -e "${RED}✗ $1${NC}"; }

usage() {
  cat <<EOF
Usage: ./publish_site [options]

Options:
  --help           Show this help message and exit
  --dry-run        Prepare deployment without committing or uploading
  --skip-git       Skip git add/commit/push
  --skip-upload    Skip FTP upload to GoDaddy
  --message "TEXT" Commit message to use when committing changes
EOF
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help)    usage; exit 0 ;;
      --dry-run)
        DRY_RUN=true; SKIP_GIT=true; SKIP_UPLOAD=true; shift ;;
      --skip-git)    SKIP_GIT=true;    shift ;;
      --skip-upload) SKIP_UPLOAD=true; shift ;;
      --message)
        if [[ $# -lt 2 ]]; then print_error "--message requires a value"; exit 1; fi
        COMMIT_MESSAGE="$2"; shift 2 ;;
      *) print_error "Unknown option: $1"; usage; exit 1 ;;
    esac
  done
}

require_command() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    print_error "Required command not found: $cmd"
    exit 1
  fi
}

# ------------------------------------------------------------------
# Step 1: Git commit and push to GitHub
# ------------------------------------------------------------------
commit_and_push() {
  if [[ "$SKIP_GIT" == true ]]; then
    print_info "Skipping git commit/push step"
    return
  fi

  if [[ -z "$(git -C "$PROJECT_DIR" status --porcelain)" ]]; then
    print_success "No repository changes to commit"
    return
  fi

  print_info "Committing and pushing repository changes to GitHub..."
  git -C "$PROJECT_DIR" add -A
  git -C "$PROJECT_DIR" commit -m "$COMMIT_MESSAGE"
  git -C "$PROJECT_DIR" push origin HEAD
  print_success "Repository changes pushed to GitHub"
}

# ------------------------------------------------------------------
# Step 2: Build local SHA256 manifest (checksum-based)
# ------------------------------------------------------------------
build_local_manifest() {
  local manifest_path="$1"

  python3 -c "
import hashlib, os, sys
from pathlib import Path

deploy_dir = Path('$PROJECT_DIR')
manifest_path = Path('$manifest_path')
exclude_names = {'.git', '.DS_Store', '.ftp-config.json', '.deploy-manifest.sha256'}
exclude_suffixes = {'.pyc', '.pyo', '.mp4'}

rows = []
for file_path in sorted(p for p in deploy_dir.rglob('*') if p.is_file()):
    # Skip excluded directories/files
    parts = file_path.relative_to(deploy_dir).parts
    if any(p in exclude_names for p in parts):
        continue
    if file_path.suffix in exclude_suffixes:
        continue
    if file_path.name == '.deploy-manifest.sha256':
        continue

    rel = file_path.relative_to(deploy_dir).as_posix()
    h = hashlib.sha256()
    with file_path.open('rb') as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b''):
            h.update(chunk)
    rows.append(f'{rel}\t{h.hexdigest()}\n')

manifest_path.write_text(''.join(rows), encoding='utf-8')
"
}

# ------------------------------------------------------------------
# Step 3: Compare local vs remote manifest to find changed files
# ------------------------------------------------------------------
build_changed_files_list() {
  local local_manifest="$1"
  local remote_manifest="$2"
  local changed_list="$3"

  python3 -c "
import os, sys
from pathlib import Path

local_manifest = Path('$local_manifest')
remote_manifest = Path('$remote_manifest')
changed_list = Path('$changed_list')

def parse_manifest(path: Path) -> dict:
    if not path.exists():
        return {}
    rows = {}
    for line in path.read_text(encoding='utf-8').splitlines():
        if not line.strip() or '\t' not in line:
            continue
        rel, digest = line.split('\t', 1)
        rows[rel.strip()] = digest.strip()
    return rows

local_rows = parse_manifest(local_manifest)
remote_rows = parse_manifest(remote_manifest)

changed = sorted(
    rel for rel, digest in local_rows.items()
    if remote_rows.get(rel) != digest
)

changed_list.write_text('\n'.join(changed) + ('\n' if changed else ''), encoding='utf-8')
"
}

# ------------------------------------------------------------------
# Step 4: Upload changed files to GoDaddy via FTP
# ------------------------------------------------------------------
upload_to_godaddy() {
  if [[ "$SKIP_UPLOAD" == true ]]; then
    print_info "Skipping GoDaddy FTP upload step"
    return
  fi

  require_command lftp
  require_command python3

  if [[ ! -f "$FTP_CONFIG" ]]; then
    print_error "FTP config not found: $FTP_CONFIG"
    exit 1
  fi

  # Read FTP credentials from config
  local ftp_host ftp_port ftp_user ftp_pass ftp_remote
  eval "$(
    python3 -c "
import json
with open('$FTP_CONFIG') as f:
    cfg = json.load(f)
print(f'ftp_host={cfg[\"host\"]}')
print(f'ftp_port={cfg[\"port\"]}')
print(f'ftp_user={cfg[\"username\"]}')
print(f'ftp_pass={cfg[\"password\"]}')
print(f'ftp_remote={cfg[\"remotePath\"]}')
"
  )"

  local tmp_dir
  tmp_dir="$(mktemp -d)"
  local local_manifest="$tmp_dir/local-manifest.sha256"
  local remote_manifest="$tmp_dir/remote-manifest.sha256"
  local changed_list="$tmp_dir/changed-files.txt"
  local delta_dir="$tmp_dir/upload-delta"

  print_info "Building local SHA256 checksum manifest..."
  build_local_manifest "$local_manifest"

  # Try to fetch the remote manifest from the server
  print_info "Fetching remote manifest (if exists)..."
  lftp -u "$ftp_user","$ftp_pass" "$ftp_host" \
    -e "set ftp:passive-mode on; set ftp:ssl-allow no; set cmd:fail-exit no; get $ftp_remote/.deploy-manifest.sha256 -o $remote_manifest; bye" \
    >/dev/null 2>&1 || true

  if [[ -s "$remote_manifest" ]]; then
    print_success "Remote manifest found"
  else
    print_info "No remote manifest found; will upload all files (first publish)"
  fi

  build_changed_files_list "$local_manifest" "$remote_manifest" "$changed_list"

  local changed_count
  changed_count="$(wc -l < "$changed_list" | tr -d ' ')"
  local total_files
  total_files="$(wc -l < "$local_manifest" | tr -d ' ')"

  echo -e "${YELLOW}  Files: $total_files total, $changed_count changed${NC}"

  if [[ "$changed_count" == "0" ]]; then
    print_success "No content changes detected; nothing to upload"
    rm -rf "$tmp_dir"
    return
  fi

  print_info "Uploading $changed_count changed/new file(s) to GoDaddy ($REMOTE_PATH) based on checksum diff..."

  mkdir -p "$delta_dir"
  require_command rsync

  # Copy only changed files preserving structure
  (
    cd "$PROJECT_DIR"
    rsync -a --files-from="$changed_list" ./ "$delta_dir/"
  )

  # Include the updated manifest
  cp "$local_manifest" "$delta_dir/.deploy-manifest.sha256"

  # Upload to GoDaddy via FTP
  lftp -u "$ftp_user","$ftp_pass" "$ftp_host" \
    -e "
      set ftp:passive-mode on;
      set ftp:ssl-allow no;
      mirror -R --verbose --no-perms $delta_dir $ftp_remote;
      bye
    "

  rm -rf "$tmp_dir"
  print_success "GoDaddy upload completed"
}

# ------------------------------------------------------------------
# Main
# ------------------------------------------------------------------
main() {
  parse_args "$@"

  cd "$PROJECT_DIR"

  echo "=============================================="
  echo "  AniShiv.com - Publish Site"
  echo "=============================================="

  require_command git
  require_command lftp
  require_command python3
  require_command rsync

  # Step 1: Git commit & push
  commit_and_push

  # Step 2: FTP upload (checksum-based)
  upload_to_godaddy

  if [[ "$DRY_RUN" == true ]]; then
    print_success "Dry run completed"
  else
    print_success "Publish completed"
  fi
}

main "$@"